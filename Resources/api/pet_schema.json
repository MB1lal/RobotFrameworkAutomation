{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Petstore pet",
  "type": "object",
  "required": ["id", "name", "status"],
  "properties": {
    "id": { "type": "integer" },
    "category": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "name": { "type": "string", "minLength": 1 },
    "photoUrls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "object" }
    },
    "status": { "type": "string", "enum": ["available", "pending", "sold"] }
  }
}
