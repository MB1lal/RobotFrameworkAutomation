# Copy to .env and fill in real values. Never commit .env.
PET_BASE_URL=https://petstore.swagger.io/v2/pet
HEROKU_URL=https://the-internet.herokuapp.com/login
HEROKU_USER=tomsmith
HEROKU_PASSWORD=SuperSecretPassword!
BROWSER=Chrome
HEADLESS=false
TIMEOUT=10s
VERIFY_TLS=true
# Set to e.g. http://localhost:4444/wd/hub to run Selenium suites on a Grid.
GRID_URL=
# Absolute driver/binary paths for environments where Selenium Manager
# cannot resolve them (e.g. distro Chromium in Docker). Leave empty locally.
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
# CHROME_BINARY=/usr/bin/chromium
API_TIMEOUT=10
API_MAX_RETRIES=3
